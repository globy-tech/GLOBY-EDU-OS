# Example environment configuration for GlobyEdu backend.
# Keep this file free of real secrets. Copy it to .env and fill in the actual values.
# This template matches the environment variables currently used by the backend code.

# Runtime environment
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# App URL
# In production, set this to the public HTTPS app origin. Add its domain to
# Firebase Authentication's authorized domains for verification action links.
APP_URL=http://localhost:4000
# In production, allow the public application domains even when this value is unset.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,https://globyedu.com,https://www.globyedu.com

# Legacy database / Prisma compatibility path. Keep isolated during Firebase migration.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Local development can explicitly select JSON. Production must set this to firebase.
DATA_STORE_MODE=json

# Supabase is development-only compatibility storage and must not be configured in production.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Authentication / tokens
JWT_ACCESS_SECRET=replace_with_access_secret
JWT_REFRESH_SECRET=replace_with_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_SALT_ROUNDS=12
EMAIL_TOKEN_MINUTES=60
DEV_SUPER_ADMIN_PASSWORD=replace_for_local_dev_only

# Firebase web configuration (public config exposed by the backend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# One-time first production Super Admin bootstrap. Configure only in the deployment
# environment immediately before an operator manually runs:
# npm run bootstrap:super-admin -- --confirm
# Remove/rotate the bootstrap secret after successful initialization.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_BOOTSTRAP_SECRET=
ORPHANED_SUPER_ADMIN_RECOVERY_SECRET=

# Firebase Admin service account (backend only)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 object storage (optional production storage provider)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=globyedu-school-files
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Teacher invitation email providers (server-side only).
# Brevo is preferred when BREVO_API_KEY and BREVO_SENDER_EMAIL are set.
# Resend is used when Brevo is unavailable and as a safe fallback for rejected Brevo requests.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# RESEND_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Resend contact-form recipient (not used as a teacher-invitation sender).
CONTACT_EMAIL=your-inbox@example.com
